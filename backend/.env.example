# Copy file ini jadi .env, lalu isi nilainya
# .env JANGAN di-push ke Git!

# Database — pilih salah satu:
# Opsi A (Neon/Supabase cloud): paste connection string dari dashboard
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
# Opsi B (Postgres lokal): postgresql://postgres:PASSWORD@localhost:5432/hris_db?schema=public
# Opsi C (Docker): postgresql://root:password@localhost:5434/hris_db?schema=public

# Secret untuk JWT — generate dengan: openssl rand -base64 32
JWT_SECRET="ganti-dengan-random-string-minimal-32-karakter"
